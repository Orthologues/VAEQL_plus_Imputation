/*
 * Deployment profile for nextflow_conf.nf.
 *
 * Replace the CHANGE_ME values at launch time or in an untracked override.
 * Do not put AWS credentials, SSE-C keys, PDS identifiers, or private paths in
 * this tracked file.
 */

plugins {
    id 'nf-amazon'
}

params.aws_region          = 'eu-central-1'
params.batch_queue         = 'CHANGE_ME'
params.aws_cli_path        = '/usr/bin/aws'
params.nextflow_work_dir   = 's3://CHANGE_ME/nextflow-work'
params.mountpoint_volume   = '/mnt/pds:/mnt/pds:r'
params.executor            = 'awsbatch'

process {
    executor = 'awsbatch'
    queue = params.batch_queue
}

workDir = params.nextflow_work_dir

aws {
    region = params.aws_region
    batch {
        cliPath = params.aws_cli_path
        volumes = params.mountpoint_volume
    }
}
